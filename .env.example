# Copy to .env for local runs. Never commit .env.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# Optional: base64-encoded Netscape cookies.txt for yt-dlp.
# Required when GitHub runner IPs hit YouTube's bot check.
